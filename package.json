{
  "name": "miriel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/shared packages/indexer packages/api",
    "clean": "tsc -b --clean packages/shared packages/indexer packages/api",
    "test": "npm test --workspaces --if-present",
    "pretest": "npm run build",
    "migrate": "node packages/indexer/dist/cli.js migrate",
    "premigrate": "npm run build",
    "indexer": "node packages/indexer/dist/cli.js",
    "preindexer": "npm run build",
    "retrieve": "node packages/api/dist/retrieve-cli.js",
    "preretrieve": "npm run build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "answer": "node packages/api/dist/answer-cli.js",
    "preanswer": "npm run build",
    "api": "node packages/api/dist/main.js",
    "preapi": "npm run build",
    "dev:api": "npm run dev -w @miriel/api"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
