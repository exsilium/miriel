# Copy to .env and fill in. .env is gitignored.

# Anthropic (answer generation, Phase 3+)
ANTHROPIC_API_KEY=

# Voyage AI (embeddings, optional rerank). Separate account from Anthropic:
# https://dashboard.voyageai.com/organization/api-keys
VOYAGE_API_KEY=

# Postgres. Compose sets this for containers; this default is for running
# tools on the host against the compose db.
DATABASE_URL=postgres://miriel:miriel@localhost:5432/miriel

# Where the source PDFs and page-image directories live (paths in
# config/books.json are relative to this). ./data on the host (relative to the
# repo root; run tools from there), /data in Docker. Used by the api and by scripts/*.py.
DATA_DIR=./data
# Page thumbnail cache for the "Pages consulted" strip (default: <tmpdir>/miriel-thumbs; /cache/thumbs in Docker).
# THUMB_CACHE_DIR=

# Embeddings: voyage (default) | fake (deterministic vectors, no network; tests only)
EMBEDDINGS_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4

# Rerank (Phase 2, default off)
RERANK_ENABLED=false
RERANK_MODEL=rerank-2.5

# Answer generation (Phase 3)
ANSWER_MODEL=claude-sonnet-5
ANSWER_MAX_TOKENS=16000
# ANSWER_EFFORT=medium            # optional output_config.effort
# citations (default, Anthropic citations API) | inline ([Vol 1, p. 214] markers parsed by regex)
CITATIONS_MODE=citations

# HTTP API (Phase 4)
PORT=8080
HOST=0.0.0.0
# Browser origin allowed in dev (Vite). Leave unset in Compose: nginx serves web and api from one origin.
# CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Page retakes (docs/build-spec-retakes.md). Routes are off unless RETAKE_ENABLED=true. Changes need a login:
# users upload and submit photos, an admin approves the re-extraction (§11). RETAKE_TOKEN (optional) is for
# scripts: the x-retake-token header with admin rights. The worker (compose retake-worker) stops starting new
# re-extractions once the day's retake spend would pass RETAKE_DAILY_BUDGET_USD.
# RETAKE_ENABLED=true
# RETAKE_TOKEN=
# RETAKE_DAILY_BUDGET_USD=10
# UPLOAD_DIR=/tmp/miriel-uploads   # outside Compose (npm run dev:api); Compose uses the uploads volume

# Accounts (docs/build-spec-checklist.md). Admins create users (no sign-up); the first admin comes from
# `npm run user -- add <name> --admin`. AUTH_REQUIRED=true puts every page and api route behind the login
# (do this when the site is reachable from outside your network: chat spends Anthropic credit); otherwise only
# checklist progress and user admin need one. COOKIE_SECURE=true when served over https. TRUST_PROXY=true only
# behind a reverse proxy that sets X-Forwarded-For (Compose sets it for the api).
# AUTH_REQUIRED=false
# COOKIE_SECURE=false
# TRUST_PROXY=false
