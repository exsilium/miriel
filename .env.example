# Copy to .env and fill in. .env is gitignored.

# Anthropic (answer generation, Phase 3+)
ANTHROPIC_API_KEY=

# Voyage AI (embeddings, optional rerank). Separate account from Anthropic:
# https://dashboard.voyageai.com/organization/api-keys
VOYAGE_API_KEY=

# Postgres. Compose sets this for containers; this default is for running
# tools on the host against the compose db.
DATABASE_URL=postgres://miriel:miriel@localhost:5432/miriel

# Where the source PDFs and page-image directories live (paths in
# config/books.json are relative to this). Repo root on the host, /data in Docker.
DATA_DIR=.

# Embeddings: voyage (default) | fake (deterministic vectors, no network; tests only)
EMBEDDINGS_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4

# Rerank (Phase 2, default off)
RERANK_ENABLED=false
RERANK_MODEL=rerank-2.5

# Answer generation (Phase 3)
ANSWER_MODEL=claude-sonnet-5
ANSWER_MAX_TOKENS=4096
# ANSWER_EFFORT=medium            # optional output_config.effort
# citations (default, Anthropic citations API) | inline ([Vol 1, p. 214] markers parsed by regex)
CITATIONS_MODE=citations

# HTTP API (Phase 4)
PORT=8080
HOST=0.0.0.0
# Browser origin allowed in dev (Vite). Leave unset in Compose: nginx serves web and api from one origin.
# CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
